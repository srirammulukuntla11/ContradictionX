# ContradictionX Root Environment Configuration Example

# Backend Environment Variables (backend/.env)
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/contradictionx
# Alternatively for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/contradictionx?retryWrites=true&w=majority
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Frontend Environment Variables (frontend/.env)
# Leave empty in local development to use Vite proxy (/api)
VITE_API_BASE_URL=
# For production deployment on Vercel:
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
